# Sparky_rATS skeleton. Copy to .env and fill in. Never commit .env.
# Host publish addresses stay on the Tailscale interface or localhost (ADR-013).

# Host directory mounted at /data inside the containers.
SPARKY_HOST_DATA_DIR=/mnt/data/sparky_rats

# Address Docker publishes ports on. Use the Tailscale IP on the Spark.
SPARKY_BIND_HOST=127.0.0.1

# Backend
SPARKY_DATA_DIR=/data
SPARKY_OLLAMA_BASE_URL=http://ollama:11434
SPARKY_API_HOST=0.0.0.0
# Host port for the API. The container still listens on 8000; 8000 on the
# Spark is already taken by Portainer.
SPARKY_API_PORT=8002
SPARKY_MCP_PORT=8001

# Role names are configuration (ADR-002). Slice 5 confirms them on the Spark.
SPARKY_MODEL_FAST=qwen3:30b-a3b
SPARKY_MODEL_HEAVY=gpt-oss:120b
SPARKY_MODEL_VISION=qwen3-vl:8b
SPARKY_MODEL_EMBED=bge-m3

# Optional Fernet key (urlsafe base64). When unset, the backend writes
# /data/credentials/master.key mode 0600 on first start.
SPARKY_MASTER_KEY=

# Optional bearer tokens. When unset, the backend generates them and writes
# /data/credentials/api_token and /data/credentials/mcp_token (mode 0600).
# Keep these distinct so MCP automation does not receive UI access (ADR-013).
SPARKY_API_TOKEN=
SPARKY_MCP_TOKEN=

# Comma-separated client hosts allowed to assert Tailscale-User-Login.
# Direct uvicorn on the host: 127.0.0.1,::1
# Behind Docker port publish, tailscale serve appears as the bridge gateway,
# so set that address here instead of trusting the header from the LAN.
SPARKY_TAILSCALE_PROXY_HOSTS=127.0.0.1,::1

SPARKY_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Browser origin for the public health check. This is a public URL, not a secret.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8002

# Next.js server proxy. Inside Compose this is http://backend:8000.
SPARKY_API_BASE=http://127.0.0.1:8002
