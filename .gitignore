# -----------------------------------------------------------------------------
# 13. Allow-list (re-include files the extension rules above would hide)
# -----------------------------------------------------------------------------
# Synthetic test fixtures (cached Profesia HTML, sample JSON, text) and
# synthetic sample PDFs used by parser tests. Never put real documents here.
!backend/tests/fixtures/**

# Frontend static assets and docs images
!frontend/public/**
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.svg
