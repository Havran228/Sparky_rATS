# -----------------------------------------------------------------------------
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ckpt
*.h5
*.tflite
*.npy
*.npz
/model_weights/
/model_cache/
.ollama/
.docling/
.crawl4ai/
.playwright/
ms-playwright/
.torch/
.cache/


