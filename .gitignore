# =============================================================================
# Sparky_rATS .gitignore
#
# This repository is public. Everything that can hold personal data, candidate
# documents, recruiter correspondence, OAuth material, model weights, or
# machine-specific configuration is ignored here.
#
# Rules of this file:
#   - State directories are anchored to the repo root (leading slash) so that
#     source folders with the same name (e.g. frontend/src/app/bundles/) are
#     never hidden by accident.
#   - Documents and media are ignored by extension everywhere, with explicit
#     allow-lists for Typst templates, synthetic test fixtures, frontend public
#     assets, and docs images.
#   - If a new kind of sensitive artifact is introduced, add it in the matching
#     section BEFORE the code that produces it is committed.
#
# Verify with:  git check-ignore -v <path>
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Sparky_rATS persistent state (the /data mount and its contents)
# -----------------------------------------------------------------------------
# Canonical mount: /mnt/data/sparky_rats (host) -> /data (containers).
# Ignore the folder at the repo root and any local-dev copy.
/data/
/mnt/
/sparky_rats_data/
/.data/

# The individual sub-folders of the mount, anchored to the root in case any of
# them is ever created outside /data during development.
/qdrant/
/qdrant_storage/
/bundles/
/inbox/
/exports/
/credentials/
/backups/
/ollama/

# Qdrant embedded-mode lock files, wherever a storage directory ends up.
.lock
exclusive.lock


# -----------------------------------------------------------------------------
# 2. Databases (SQLite and friends), anywhere in the tree
# -----------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sql.gz
*.dump
*.bak


# -----------------------------------------------------------------------------
# 3. Secrets, credentials, tokens, keys
# -----------------------------------------------------------------------------
# Environment files (examples/templates are allowed)
.env
.env.*
*.env
!.env.example
!.env.template
!.env.sample

# Secret stores by name
secrets.json
secrets.yaml
secrets.yml
secrets.toml
secrets.local.*
*.secret
*.secrets
env.json

# Keys and certificates
master.key
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.gpg
*.asc
*.ppk
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Google OAuth artifacts (ADR-011 / ADR-012)
client_secret*.json
client_secrets*.json
credentials*.json
token*.json
token.pickle
service_account*.json
gcp-*.json
*.oauth
*.oauth2

# Tailscale / VPN state
tailscaled.state
*.tskey

# Hugging Face / API tokens
.huggingface/
huggingface_token*


# -----------------------------------------------------------------------------
# 4. Candidate and recruiter content (never commit real documents)
# -----------------------------------------------------------------------------
# Real documents live under /data. These extension rules catch stray copies
# anywhere else. Intentionally committed test fixtures must be SYNTHETIC and
# must live under backend/tests/fixtures/ (allow-listed in section 13).
*.pdf
*.docx
*.doc
*.odt
*.rtf
*.eml
*.msg
*.mbox
*.ics
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.tif
*.tiff
*.bmp


# -----------------------------------------------------------------------------
